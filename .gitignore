/dist-backup-execution
/dist-stage1-verification
/dist-production-apply
/dist-backup-summary-validation
/dist-update-detection
/dist-update-orchestrator

# local SQLite DB, dev-session logs, server PID (regenerated / not redistributable — see below)
# includes: efootball.db (read-only reference data), all *.log, server.pid
/data

# third-party sample data (fetched from eFHUB; redistribution rights not confirmed — see
# docs/data-verification.md / docs/production-readiness/architecture-audit.md). Keep the
# README.md that documents the local dev setup, but never track the fetched data itself.
/src/data/cards/*.json
/src/data/players.sample.json
/src/data/meta.json

# typescript
*.tsbuildinfo

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env
.env
.env.*
!.env.example

# certificates / private keys (defensive; none currently exist in this workspace)
*.pem
*.key
*.pfx
*.p12
*.crt

# exception: synthetic, non-secret TLS test fixtures for pg-ssl-config.tls.test.ts
# (self-signed throwaway CA/server cert+key, no real-world trust, TEST ONLY — see
# src/lib/reference-data/__fixtures__/tls/README.md for generation details and scope).
!/src/lib/reference-data/__fixtures__/tls/*.pem

